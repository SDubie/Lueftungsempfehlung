# Default: normalize text files in git and use LF in working tree.
* text=auto eol=lf

# Python and project config files.
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Shell scripts.
*.sh text eol=lf

# Windows scripts should stay CRLF for compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf